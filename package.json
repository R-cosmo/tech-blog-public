{
  "name": "assignment-cms",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
      "playwright:ui": "pnpm --filter @repo/playwright ui",
      "playwright:ui:admin": "pnpm --filter @repo/playwright ui:admin",
      "playwright:ui:web": "pnpm --filter @repo/playwright ui:web",
      "playwright:dev:test-1": "pnpm --filter @repo/playwright dev:test-1",
      "playwright:dev:test-2": "pnpm --filter @repo/playwright dev:test-2",
      "playwright:dev:test-3": "pnpm --filter @repo/playwright dev:test-3",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "playwright": "^1.50.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.4",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.2.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.3.1"
  }
}
