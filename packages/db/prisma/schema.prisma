// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id          Int       @id @default(autoincrement())
  urlId       String    @unique
  title       String
  description String
  content     String
  imageUrl    String
  date        DateTime  @default(now())
  category    String
  tags        String    // comma-separated tags
  views       Int       @default(0)
  active      Boolean   @default(true)
  Likes       Like[]
  Comments    Comment[]

  @@index([active])
  @@index([category])
}

model Like {
  id     String @id @default(cuid())
  postId Int
  userIP String
  Post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userIP])
  @@index([postId])
  @@index([userIP])
}

model Comment {
  id        String    @id @default(cuid()) // Stable identifier used when creating replies.
  postId    Int // Identifies the post that owns this comment.
  parentId  String? // Null for a top-level comment; set for a nested reply.
  author    String // Display name supplied by the commenter or logged-in user.
  content   String // The text displayed in the comment thread.
  createdAt DateTime  @default(now()) // Used to display the date and preserve comment order.
  Post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade) // Remove comments when their post is deleted.
  Parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade) // Links a reply to its parent comment.
  Replies   Comment[] @relation("CommentReplies") // Contains all direct replies to this comment.

  @@index([postId])
  @@index([parentId])
}
